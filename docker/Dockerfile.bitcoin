# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                    BITCOIN KNOTS - DOCKER IMAGE                           ║
# ║                                                                            ║
# ║   Built from official GitHub release tarball.                              ║
# ║   No dependency on third-party Docker Hub images.                         ║
# ║                                                                            ║
# ║   To upgrade: change VERSION below, rebuild.                              ║
# ║                                                                            ║
# ╚════════════════════════════════════════════════════════════════════════════╝

FROM debian:bookworm-slim

ARG VERSION=29.3.knots20260508
ARG ARCH=x86_64-linux-gnu

LABEL maintainer="Spiral Miner"
LABEL description="Bitcoin Knots Node for Spiral Pool"
LABEL version="${VERSION}"

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl gosu gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Download and install Bitcoin Knots from official GitHub release
RUN curl -fsSL "https://github.com/bitcoinknots/bitcoin/releases/download/v${VERSION}/bitcoin-${VERSION}-${ARCH}.tar.gz" \
        -o /tmp/bitcoin.tar.gz \
    && tar -xzf /tmp/bitcoin.tar.gz -C /tmp/ \
    && mv /tmp/bitcoin-${VERSION}/bin/bitcoind /usr/local/bin/ \
    && mv /tmp/bitcoin-${VERSION}/bin/bitcoin-cli /usr/local/bin/ \
    && mv /tmp/bitcoin-${VERSION}/bin/bitcoin-tx /usr/local/bin/ \
    && rm -rf /tmp/bitcoin* \
    && chmod +x /usr/local/bin/bitcoind /usr/local/bin/bitcoin-cli /usr/local/bin/bitcoin-tx

# Create bitcoin user
RUN useradd -m -s /bin/bash bitcoin

# Expose ports
EXPOSE 8333 8332 28332

# Data volume
VOLUME ["/home/bitcoin/.bitcoin"]

# Create entrypoint script
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
if [ -f /home/bitcoin/.bitcoin/bitcoin.conf ] && [ -s /home/bitcoin/.bitcoin/bitcoin.conf ]; then\n\
    echo "Using existing bitcoin.conf (skipping template generation)"\n\
elif [ -f /config/bitcoin.conf.template ]; then\n\
    envsubst < /config/bitcoin.conf.template > /home/bitcoin/.bitcoin/bitcoin.conf\n\
    chmod 600 /home/bitcoin/.bitcoin/bitcoin.conf\n\
fi\n\
\n\
chown -R bitcoin:bitcoin /home/bitcoin/.bitcoin\n\
exec gosu bitcoin bitcoind -printtoconsole "$@"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
